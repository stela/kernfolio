@import gg.jte.Content

@param title: String
@param nonce: String
@param csrfToken: String
@param csrfHeaderName: String
@param content: Content
@param scripts: gg.jte.Content = gg.jte.Content { }
@param includeChartJs: Boolean = false
@param authenticated: Boolean = true

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="${csrfToken}">
    <meta name="csrf-header" content="${csrfHeaderName}">
    <title>${title}</title>
    <link rel="stylesheet" href="/css/tailwind.css" nonce="${nonce}">
</head>
<body class="min-h-screen bg-gray-50 text-gray-900">

    <nav class="bg-white border-b border-gray-200">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="flex h-16 items-center justify-between">
                <a href="/" class="text-xl font-semibold text-gray-900">Kernfolio</a>
                @if(authenticated)
                    <a href="/about" class="text-sm font-medium text-gray-600 hover:text-gray-900">About</a>
                @else
                    <div class="flex items-center gap-4">
                        <a href="/about" class="text-sm font-medium text-gray-600 hover:text-gray-900">About</a>
                        <a href="/login" class="text-sm font-medium text-gray-600 hover:text-gray-900">Login</a>
                        <a href="/register" class="rounded-md bg-blue-600 px-3 py-2 text-sm font-medium text-white shadow-sm hover:bg-blue-700">Register</a>
                    </div>
                @endif
            </div>
        </div>
    </nav>

    <div id="global-error-banner" class="hidden mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 mt-4" role="alert" aria-live="polite">
        <div class="rounded-lg border border-red-200 bg-red-50 p-4 flex items-start">
            <svg class="h-5 w-5 text-red-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/>
            </svg>
            <p id="global-error-message" class="ml-3 text-sm text-red-800 flex-1"></p>
            <button type="button" id="global-error-dismiss" class="ml-3 text-red-600 hover:text-red-800" aria-label="Dismiss">&times;</button>
        </div>
    </div>

    ${content}

    <footer class="mt-auto border-t border-gray-200 bg-white">
        <div class="mx-auto max-w-7xl px-4 py-4 text-center text-sm text-gray-500 sm:px-6 lg:px-8">
            Kernfolio
        </div>
    </footer>

    <script src="/js/csrf-fetch.js" nonce="${nonce}"></script>
    <script src="/js/http.js" nonce="${nonce}"></script>
    <script src="/js/flash.js" nonce="${nonce}"></script>
    @if(includeChartJs)
        <script src="/webjars/chart.js/4.5.1/dist/chart.umd.min.js" nonce="${nonce}"></script>
    @endif
    ${scripts}
</body>
</html>
