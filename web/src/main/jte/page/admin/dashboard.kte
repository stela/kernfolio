@param userCount: Long
@param enabledUserCount: Long
@param flagCount: Int
@param activeFlagCount: Int
@param nonce: String
@param csrfToken: String
@param csrfHeaderName: String

@template.layout.base(
    title = "Admin - Kernfolio",
    nonce = nonce,
    csrfToken = csrfToken,
    csrfHeaderName = csrfHeaderName,
    content = @`
    <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <h1 class="text-2xl font-semibold mb-8">Admin Panel</h1>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4 mb-8">
            <div class="rounded-lg border border-gray-200 bg-white p-6">
                <p class="text-sm text-gray-500">Total users</p>
                <p class="text-3xl font-semibold mt-1">${userCount}</p>
                <p class="text-sm text-gray-400 mt-1">${enabledUserCount} enabled</p>
            </div>
            <div class="rounded-lg border border-gray-200 bg-white p-6">
                <p class="text-sm text-gray-500">Feature flags</p>
                <p class="text-3xl font-semibold mt-1">${flagCount}</p>
                <p class="text-sm text-gray-400 mt-1">${activeFlagCount} active</p>
            </div>
        </div>

        <div class="flex gap-4">
            <a href="/admin/users"
               class="rounded-lg border border-gray-200 bg-white px-6 py-4 shadow-sm hover:shadow-md transition-shadow">
                Manage users
            </a>
            <a href="/admin/flags"
               class="rounded-lg border border-gray-200 bg-white px-6 py-4 shadow-sm hover:shadow-md transition-shadow">
                Manage feature flags
            </a>
        </div>
    </main>
    `
)
