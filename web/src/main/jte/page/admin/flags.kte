@import com.kernfolio.domain.FeatureFlag

@param flags: List<FeatureFlag>
@param nonce: String
@param csrfToken: String
@param csrfHeaderName: String

@template.layout.base(
    title = "Feature Flags - Admin - Kernfolio",
    nonce = nonce,
    csrfToken = csrfToken,
    csrfHeaderName = csrfHeaderName,
    content = @`
    <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between mb-6">
            <h1 class="text-2xl font-semibold">Feature Flags</h1>
            <a href="/admin" class="text-sm font-medium text-blue-600 hover:text-blue-500">Back to admin</a>
        </div>

        <div class="bg-white shadow rounded-lg overflow-hidden">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500">Flag</th>
                        <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500">Description</th>
                        <th class="px-4 py-3 text-center text-xs font-medium uppercase text-gray-500">Enabled</th>
                        <th class="px-4 py-3 text-right text-xs font-medium uppercase text-gray-500">Rollout %</th>
                        <th class="px-4 py-3 text-right text-xs font-medium uppercase text-gray-500">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    @for(flag in flags)
                        @template.partial.admin-flag-row(flag = flag)
                    @endfor
                </tbody>
            </table>
        </div>
    </main>
    `,
    scripts = @`
        <script src="/js/admin-flags.js" nonce="${nonce}"></script>
    `
)
