@import com.kernfolio.controller.FormErrors
@import com.kernfolio.controller.RegistrationForm

@param registrationForm: RegistrationForm
@param selfRegistrationEnabled: Boolean
@param errors: FormErrors = FormErrors(null)
@param nonce: String
@param csrfToken: String
@param csrfHeaderName: String

@template.layout.base(
    title = "Register - Kernfolio",
    nonce = nonce,
    csrfToken = csrfToken,
    csrfHeaderName = csrfHeaderName,
    content = @`
    <main class="mx-auto max-w-md px-4 py-16 sm:px-6">
        <div class="bg-white shadow rounded-lg p-8">
            <h1 class="text-2xl font-semibold text-center mb-6">Create an account</h1>

            <form action="/register" method="post" class="space-y-5">
                <input type="hidden" name="_csrf" value="${csrfToken}">

                @if(errors.hasGlobalErrors())
                    <div class="rounded-md bg-red-50 p-4">
                        @for(err in errors.globalErrors())
                            <p class="text-sm text-red-700">${err}</p>
                        @endfor
                    </div>
                @endif

                <div>
                    <label for="username" class="block text-sm font-medium text-gray-700 mb-1">Username</label>
                    <input type="text" id="username" name="username" value="${registrationForm.username}" required autocomplete="username"
                           class="block w-full rounded-md border ${if (errors.has("username")) "border-red-300" else "border-gray-300"} px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
                    @if(errors.has("username"))
                        <p class="mt-1 text-sm text-red-600">${errors.get("username")}</p>
                    @endif
                </div>

                <div>
                    <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                    <input type="email" id="email" name="email" value="${registrationForm.email}" required autocomplete="email"
                           class="block w-full rounded-md border ${if (errors.has("email")) "border-red-300" else "border-gray-300"} px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
                    @if(errors.has("email"))
                        <p class="mt-1 text-sm text-red-600">${errors.get("email")}</p>
                    @endif
                </div>

                <div>
                    <label for="password" class="block text-sm font-medium text-gray-700 mb-1">Password</label>
                    <input type="password" id="password" name="password" required autocomplete="new-password"
                           class="block w-full rounded-md border ${if (errors.has("password")) "border-red-300" else "border-gray-300"} px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
                    @if(errors.has("password"))
                        <p class="mt-1 text-sm text-red-600">${errors.get("password")}</p>
                    @endif
                </div>

                <div>
                    <label for="confirmPassword" class="block text-sm font-medium text-gray-700 mb-1">Confirm password</label>
                    <input type="password" id="confirmPassword" name="confirmPassword" required autocomplete="new-password"
                           class="block w-full rounded-md border ${if (errors.has("confirmPassword")) "border-red-300" else "border-gray-300"} px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
                    @if(errors.has("confirmPassword"))
                        <p class="mt-1 text-sm text-red-600">${errors.get("confirmPassword")}</p>
                    @endif
                </div>

                @if(!selfRegistrationEnabled)
                    <div>
                        <label for="inviteCode" class="block text-sm font-medium text-gray-700 mb-1">Invite code</label>
                        <input type="text" id="inviteCode" name="inviteCode" value="${registrationForm.inviteCode}" required autocomplete="off"
                               class="block w-full rounded-md border ${if (errors.has("inviteCode")) "border-red-300" else "border-gray-300"} px-3 py-2 text-sm shadow-sm font-mono tracking-wider uppercase focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
                        @if(errors.has("inviteCode"))
                            <p class="mt-1 text-sm text-red-600">${errors.get("inviteCode")}</p>
                        @endif
                    </div>
                @endif

                <button type="submit"
                        class="w-full rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                    Create account
                </button>
            </form>

            <p class="mt-6 text-center text-sm text-gray-500">
                Already have an account?
                <a href="/login" class="font-medium text-blue-600 hover:text-blue-500">Sign in</a>
            </p>
        </div>
    </main>
    `
)
