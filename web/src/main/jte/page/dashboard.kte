@import com.kernfolio.domain.Portfolio

@param portfolios: List<Portfolio>
@param username: String
@param nonce: String
@param csrfToken: String
@param csrfHeaderName: String

@template.layout.base(
    title = "Dashboard - Kernfolio",
    nonce = nonce,
    csrfToken = csrfToken,
    csrfHeaderName = csrfHeaderName,
    content = @`
    <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between mb-8">
            <h1 class="text-2xl font-semibold">Your Portfolios</h1>
            <a href="/portfolios/new"
               class="rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-blue-700">
                New portfolio
            </a>
        </div>

        @if(portfolios.isEmpty())
            <div class="text-center py-16">
                <p class="text-gray-500 mb-4">No portfolios yet.</p>
                <a href="/portfolios/new" class="font-medium text-blue-600 hover:text-blue-500">
                    Create your first portfolio
                </a>
            </div>
        @else
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                @for(p in portfolios)
                    <a href="/portfolios/${p.id.toString()}"
                       class="block rounded-lg border border-gray-200 bg-white p-6 shadow-sm hover:shadow-md transition-shadow">
                        <h2 class="text-lg font-medium text-gray-900">${p.name}</h2>
                        @if(p.description != null)
                            <p class="mt-1 text-sm text-gray-500">${p.description}</p>
                        @endif
                        <div class="mt-4 flex items-center gap-4 text-sm text-gray-400">
                            <span>${p.baseCurrency}</span>
                            @if(p.createdAt != null)
                                <span>${p.createdAt.toString().substring(0, 10)}</span>
                            @endif
                        </div>
                    </a>
                @endfor
            </div>
        @endif
    </main>
    `
)
