@import com.kernfolio.controller.FormErrors
@import com.kernfolio.controller.PortfolioForm
@import java.util.UUID

@param portfolioForm: PortfolioForm
@param portfolioId: UUID? = null
@param errors: FormErrors = FormErrors(null)
@param nonce: String
@param csrfToken: String
@param csrfHeaderName: String

!{val isEdit = portfolioId != null}

@template.layout.base(
    title = if(isEdit) "Edit Portfolio - Kernfolio" else "New Portfolio - Kernfolio",
    nonce = nonce,
    csrfToken = csrfToken,
    csrfHeaderName = csrfHeaderName,
    content = @`
    <main class="mx-auto max-w-lg px-4 py-8 sm:px-6">
        <div class="bg-white shadow rounded-lg p-8">
            <h1 class="text-2xl font-semibold mb-6">${isEdit ? "Edit Portfolio" : "New Portfolio"}</h1>

            <form action="${isEdit ? "/portfolios/" + portfolioId : "/portfolios"}" method="post" class="space-y-5">
                <input type="hidden" name="_csrf" value="${csrfToken}">

                <div>
                    <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Name</label>
                    <input type="text" id="name" name="name" value="${portfolioForm.name}" required
                           class="block w-full rounded-md border ${errors.has("name") ? "border-red-300" : "border-gray-300"} px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
                    @if(errors.has("name"))
                        <p class="mt-1 text-sm text-red-600">${errors.get("name")}</p>
                    @endif
                </div>

                <div>
                    <label for="description" class="block text-sm font-medium text-gray-700 mb-1">Description</label>
                    <textarea id="description" name="description" rows="3"
                              class="block w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500">${portfolioForm.description ?: ""}</textarea>
                </div>

                <div>
                    <label for="baseCurrency" class="block text-sm font-medium text-gray-700 mb-1">Base currency</label>
                    <input type="text" id="baseCurrency" name="baseCurrency" value="${portfolioForm.baseCurrency}" required maxlength="3"
                           class="block w-20 rounded-md border ${errors.has("baseCurrency") ? "border-red-300" : "border-gray-300"} px-3 py-2 text-sm font-mono uppercase shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
                    @if(errors.has("baseCurrency"))
                        <p class="mt-1 text-sm text-red-600">${errors.get("baseCurrency")}</p>
                    @endif
                </div>

                <div class="flex gap-3">
                    <button type="submit"
                            class="rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                        ${isEdit ? "Save changes" : "Create portfolio"}
                    </button>
                    <a href="${isEdit ? "/portfolios/" + portfolioId : "/dashboard"}"
                       class="rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </main>
    `
)
