@import com.kernfolio.domain.Position
@import java.util.Locale
@import java.util.UUID

@param position: Position
@param displayName: String
@param portfolioId: UUID

<tr>
    <td class="px-4 py-3 text-sm">${position.positionType}</td>
    <td class="px-4 py-3 text-sm font-mono font-medium">${position.ticker}</td>
    <td class="px-4 py-3 text-sm text-gray-500">${displayName}</td>
    <td class="px-4 py-3 text-sm font-mono">${position.currency}</td>
    <td class="px-4 py-3 text-sm text-right font-mono">
        @if(position.positionType == "EQUITY")
            <span data-shares-ticker="${position.ticker}"></span>
        @elseif(position.positionType == "CASH")
            <span data-cash-currency="${position.currency}"></span>
        @else
            ${String.format(Locale.ROOT, "%.2f", position.weightPct.toDouble() * 100)}%
        @endif
    </td>
    <td class="px-4 py-3 text-sm text-right">
        <div>
            <span data-weight-ticker="${position.ticker}"
                  data-weight-type="${position.positionType}"
                  data-weight-currency="${position.currency}">${String.format(Locale.ROOT, "%.2f", position.weightPct.toDouble() * 100)}%</span>
        </div>
        <div class="text-xs text-gray-400 font-mono mt-0.5"
             data-weight-breakdown-ticker="${position.ticker}"
             data-weight-breakdown-type="${position.positionType}"
             data-weight-breakdown-currency="${position.currency}"></div>
    </td>
    <td class="px-4 py-3 text-sm text-gray-500">${position.sector}</td>
    <td class="px-4 py-3 text-sm text-right whitespace-nowrap">
        <button type="button"
                data-edit-position="/portfolios/${portfolioId.toString()}/positions/${position.id.toString()}/edit-row"
                class="text-blue-600 hover:text-blue-800 text-sm font-medium mr-3">
            Edit
        </button>
        <button type="button"
                data-delete-position="/portfolios/${portfolioId.toString()}/positions/${position.id.toString()}"
                class="text-red-600 hover:text-red-800 text-sm font-medium">
            Remove
        </button>
    </td>
</tr>
