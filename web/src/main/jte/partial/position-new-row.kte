@import java.util.UUID

@param portfolioId: UUID

<tr data-new-row data-submit-url="/portfolios/${portfolioId.toString()}/positions">
    <td class="px-4 py-2">
        <select name="positionType" class="js-pos-type rounded-md border border-gray-300 px-2 py-1 text-sm">
            <option value="EQUITY" selected>EQUITY</option>
            <option value="CASH">CASH</option>
        </select>
    </td>
    <td class="px-4 py-2 align-top">
        <div class="js-ticker-combobox js-equity-field w-24">
            <input type="text" name="ticker" required placeholder="Search"
                   autocomplete="off" role="combobox" aria-autocomplete="list"
                   aria-expanded="false"
                   class="js-ticker-input w-full rounded-md border border-gray-300 px-2 py-1 text-sm font-mono">
            <ul class="js-ticker-suggest hidden fixed z-50 w-80 max-h-64 overflow-y-auto rounded-md border border-gray-200 bg-white shadow-lg"
                role="listbox"></ul>
            <div class="js-ticker-status mt-1 text-xs text-gray-500 whitespace-normal break-words" aria-live="polite"></div>
        </div>
        <span class="js-cash-ticker js-cash-field hidden text-sm text-gray-500"></span>
        <input type="hidden" name="cashTicker" class="js-cash-ticker-hidden js-cash-field hidden">
    </td>
    <td class="px-4 py-2 text-sm text-gray-400">—</td>
    <td class="px-4 py-2">
        <input type="text" name="currency" value="USD" required maxlength="3"
               class="js-currency w-16 rounded-md border border-gray-300 px-2 py-1 text-sm font-mono uppercase">
    </td>
    <td class="px-4 py-2">
        <input type="number" step="any" min="0" placeholder="Shares"
               class="js-shares js-equity-field w-20 rounded-md border border-gray-300 px-2 py-1 text-sm text-right">
        <input type="number" step="0.01" min="0" placeholder="Amount"
               class="js-cash-amount js-cash-field hidden w-20 rounded-md border border-gray-300 px-2 py-1 text-sm text-right">
    </td>
    <td class="px-4 py-2 text-right text-sm text-gray-500">
        <span class="js-weight-display"></span>
    </td>
    <td class="px-4 py-2">
        <input type="text" name="sector" placeholder="Sector"
               class="js-equity-field w-24 rounded-md border border-gray-300 px-2 py-1 text-sm">
    </td>
    <td class="px-4 py-2">
        <span class="js-equity-field inline-flex items-center gap-1">
            <input type="number" step="any" min="-99" name="expectedReturn" placeholder="12"
                   title="Expected annual return, probability-weighted across your scenarios"
                   class="js-expected-return w-20 rounded-md border border-gray-300 px-2 py-1 text-sm text-right">
            <span class="text-xs text-gray-500">%</span>
        </span>
    </td>
    <td class="px-4 py-2">
        <span class="js-equity-field inline-flex items-center gap-1">
            <input type="number" step="any" min="0" name="returnStddev" placeholder="25"
                   title="Standard deviation of that return across your scenarios; wider means the market's estimate counts for more"
                   class="js-return-stddev w-20 rounded-md border border-gray-300 px-2 py-1 text-sm text-right">
            <span class="text-xs text-gray-500">%</span>
        </span>
    </td>
    <td class="px-4 py-2 text-right">
        <input type="hidden" name="weightPct" value="0">
        <input type="hidden" name="costBasisPct" value="">
        <button type="button" class="js-save-position text-blue-600 hover:text-blue-800 text-sm font-medium mr-2">
            Save
        </button>
        <button type="button" class="js-cancel-row text-gray-400 hover:text-gray-600 text-sm font-medium">
            Cancel
        </button>
    </td>
</tr>
