@import com.kernfolio.domain.Position
@import java.math.BigDecimal
@import java.util.UUID

@param position: Position
@param displayName: String
@param portfolioId: UUID

!{var isCash = position.positionType == "CASH";}
!{var sectorValue = position.sector ?: "";}
!{var ivValue = position.intrinsicValueLocal?.toPlainString() ?: "";}
!{var confValue = position.confidence?.multiply(BigDecimal(100))?.stripTrailingZeros()?.toPlainString() ?: "";}

<tr data-new-row data-edit-row
    data-submit-url="/portfolios/${portfolioId.toString()}/positions/${position.id.toString()}"
    data-submit-method="PUT">
    <td class="px-4 py-2">
        <select name="positionType" class="js-pos-type rounded-md border border-gray-300 px-2 py-1 text-sm">
            <option value="EQUITY" selected="${!isCash}">EQUITY</option>
            <option value="CASH" selected="${isCash}">CASH</option>
        </select>
    </td>
    <td class="px-4 py-2 align-top">
        <div class="js-ticker-combobox js-equity-field ${if (isCash) "hidden" else ""} w-24">
            <input type="text" name="ticker" required placeholder="Search"
                   autocomplete="off" role="combobox" aria-autocomplete="list"
                   aria-expanded="false"
                   value="${if (!isCash) position.ticker else ""}"
                   class="js-ticker-input w-full rounded-md border border-gray-300 px-2 py-1 text-sm font-mono">
            <ul class="js-ticker-suggest hidden fixed z-50 w-80 max-h-64 overflow-y-auto rounded-md border border-gray-200 bg-white shadow-lg"
                role="listbox"></ul>
            <div class="js-ticker-status mt-1 text-xs text-gray-500 whitespace-normal break-words" aria-live="polite"></div>
        </div>
        <span class="js-cash-ticker js-cash-field ${if (!isCash) "hidden" else ""} text-sm text-gray-500">${if (isCash) position.ticker else ""}</span>
        <input type="hidden" name="cashTicker" class="js-cash-ticker-hidden js-cash-field ${if (!isCash) "hidden" else ""}" value="${if (isCash) position.ticker else ""}">
    </td>
    <td class="px-4 py-2 text-sm text-gray-500">${displayName}</td>
    <td class="px-4 py-2">
        <input type="text" name="currency" value="${position.currency}" required maxlength="3"
               class="js-currency w-16 rounded-md border border-gray-300 px-2 py-1 text-sm font-mono uppercase">
    </td>
    <td class="px-4 py-2">
        <input type="number" step="any" min="0" placeholder="Shares"
               class="js-shares js-equity-field ${if (isCash) "hidden" else ""} w-20 rounded-md border border-gray-300 px-2 py-1 text-sm text-right">
        <input type="number" step="0.01" min="0" placeholder="Amount"
               class="js-cash-amount js-cash-field ${if (!isCash) "hidden" else ""} w-20 rounded-md border border-gray-300 px-2 py-1 text-sm text-right">
    </td>
    <td class="px-4 py-2 text-right text-sm text-gray-500">
        <span class="js-weight-display"></span>
    </td>
    <td class="px-4 py-2">
        <input type="text" name="sector" placeholder="Sector"
               value="${sectorValue}"
               class="js-equity-field ${if (isCash) "hidden" else ""} w-24 rounded-md border border-gray-300 px-2 py-1 text-sm">
    </td>
    <td class="px-4 py-2">
        <input type="number" step="0.01" min="0" name="intrinsicValueLocal" placeholder="IV"
               value="${ivValue}"
               class="js-iv js-equity-field ${if (isCash) "hidden" else ""} w-24 rounded-md border border-gray-300 px-2 py-1 text-sm text-right">
        <div class="js-cagr-hint js-equity-field ${if (isCash) "hidden" else ""} mt-1 text-xs text-gray-500" aria-live="polite"></div>
    </td>
    <td class="px-4 py-2">
        <span class="js-equity-field ${if (isCash) "hidden" else ""} inline-flex items-center gap-1">
            <input type="number" step="any" min="0" max="100" name="confidence" placeholder="80"
                   value="${confValue}"
                   class="js-confidence w-16 rounded-md border border-gray-300 px-2 py-1 text-sm text-right">
            <span class="text-xs text-gray-500">%</span>
        </span>
    </td>
    <td class="px-4 py-2 text-right">
        <input type="hidden" name="weightPct" value="0">
        <input type="hidden" name="costBasisPct" value="">
        <button type="button" class="js-save-position text-blue-600 hover:text-blue-800 text-sm font-medium mr-2">
            Save
        </button>
        <button type="button" class="js-cancel-row text-gray-400 hover:text-gray-600 text-sm font-medium">
            Cancel
        </button>
    </td>
</tr>
