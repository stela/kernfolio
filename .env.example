# Vault root token for production deployments. The docker-compose.yml web
# service reads this as ${VAULT_APP_TOKEN:-dev-root-token}; the default only
# works for local dev (which runs Vault in -dev mode via docker-compose.dev.yml).
# Generate a real token from your production Vault instance.
VAULT_APP_TOKEN=changeme

# The postgres superuser password is NOT an env var. It lives in
# ./secrets/pg_root_password (gitignored), generated on first run by
# ./scripts/init-secrets.sh and mounted into the postgres + vault-db-init
# containers via POSTGRES_PASSWORD_FILE / /run/secrets/pg_root_password.
# For production, either let the script generate a 32-char random value or
# overwrite the file with your own strong password before `docker compose up`.
