# OpenBao root token for production deployments. The docker-compose.yml web
# service reads this as ${BAO_APP_TOKEN:-dev-root-token}; the default only
# works for local dev (which runs OpenBao in -dev mode via docker-compose.dev.yml).
# Generate a real token from your production OpenBao instance.
BAO_APP_TOKEN=changeme

# Public hostname Caddy serves and obtains an ACME certificate for. Must
# resolve to this host, with ports 80 and 443 reachable. Leave unset for
# https://localhost with a certificate from Caddy's built-in CA.
# KERNFOLIO_DOMAIN=kernfolio.example.com

# There is no DB_ROOT_PASSWORD env var. OpenBao generates the postgres
# superuser password on first boot (see openbao/init/setup.sh), persists it in
# its KV engine, and materializes it as pg_root_password onto the
# certs_postgres and certs_openbao volumes. Postgres reads it via
# POSTGRES_PASSWORD_FILE.
