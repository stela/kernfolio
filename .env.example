# Vault root token for production deployments. The docker-compose.yml web
# service reads this as ${VAULT_APP_TOKEN:-dev-root-token}; the default only
# works for local dev (which runs Vault in -dev mode via docker-compose.dev.yml).
# Generate a real token from your production Vault instance.
VAULT_APP_TOKEN=changeme

# There is no DB_ROOT_PASSWORD env var. Vault generates the postgres
# superuser password on first boot (see vault/init/setup.sh), persists it in
# its KV engine, and materializes it onto the vault_agent_certs volume at
# /vault/certs/pg_root_password. Postgres reads it via POSTGRES_PASSWORD_FILE.
