# Postgres superuser password. Read at 'initdb' time (first postgres startup
# on an empty pgdata volume) AND by vault-db-init when it registers the
# postgres connection with Vault's database engine. The two usages must
# agree. Defaults to 'kernfolio' when unset (dev-stack convenience); set to
# something strong for production deployments.
DB_ROOT_PASSWORD=changeme

# Vault root token for production deployments. The docker-compose.yml web
# service reads this as ${VAULT_APP_TOKEN:-dev-root-token}; the default only
# works for local dev (which runs Vault in -dev mode via docker-compose.dev.yml).
# Generate a real token from your production Vault instance.
VAULT_APP_TOKEN=changeme
