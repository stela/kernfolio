{
	# Unprivileged listeners; docker publishes them as 80 / 443.
	http_port 8080
	https_port 8443
	# Caddy's automatic HTTP->HTTPS redirect would point at :8443 (its own
	# https_port), which is not the externally visible port. Redirect by hand.
	auto_https disable_redirects
	# The container's own trust store is irrelevant (and not writable as uid 1000).
	skip_install_trust
}

# A real domain gets a public certificate via ACME (HTTP-01 on :80, TLS-ALPN
# on :443). The `localhost` default gets one from Caddy's built-in CA instead.
{$KERNFOLIO_DOMAIN:localhost} {
	reverse_proxy https://web:8443 {
		transport http {
			tls_client_auth /vault/certs/caddy-client.pem /vault/certs/caddy-client-key.pem
			tls_trusted_ca_certs /vault/certs/ca.pem
		}
	}
}

http://{$KERNFOLIO_DOMAIN:localhost} {
	redir https://{host}{uri} permanent
}
